{
  // oxlint config for the web map viewer (viewer/js/*.js, `make viewer-lint`).
  //
  // Rule set: the Rika-Labs/oxlint-standards v0.8.1 anti-slop baseline plus the
  // strict-core subset applicable to browser scripts (same provenance as
  // ../zdtd/.oxlintrc.jsonc), extended 2026-08-22 with the unicorn rules the
  // viewer fixes (no-array-*, prefer-*, explicit-length-check, catch-error-name,
  // prefer-number-properties, numeric-separators-style, number-literal-case,
  // prefer-top-level-await, prefer-global-this). Warnings and errors are both
  // enforced because scripts/lint-viewer.sh runs with --deny-warnings.
  //
  // Thresholds match the strict preset: max-lines-per-function 60,
  // max-classes-per-file 1, max-lines 1500, max-nested-callbacks 4. The other
  // threshold rules (max-params, max-depth, complexity, no-magic-numbers) stay
  // off exactly as strict-core keeps them off; the viewer's canvas constants
  // (zoom factors, region threshold, canvas sizes) are domain values, not
  // unnamed magic numbers.
  //
  // Deliberate off entries:
  //   no-underscore-dangle: Map2D/GlobeView keep bound-handler fields
  //     (_onPointerMove, _boundResize, _onResize) with an underscore convention.
  //   @rikalabs/no-standalone-classes: the canvas and Three.js controllers are
  //     stateful objects with a resize/dispose lifecycle; closure rewrites
  //     would obscure the state machine.
  //   @rikalabs/no-trivial-runtime-guard-helpers: only the standard
  //     Array.isArray builtin is used; the rule bans the builtin call itself,
  //     which forces worse checks.
  //   no-bitwise: rte.js decodes the RTE1 bit-flag header; bitwise ops are
  //     required by the format.
  //   import/no-namespace: three.js ships no useful default export; the
  //     namespace import is the documented pattern.
  //   promise/avoid-new: loadImage wraps the Image onload/onerror events, which
  //     cannot be awaited any other way.
  //   promise/prefer-await-to-callbacks: conflicts with
  //     @rikalabs/no-silent-catch-fallback for error-rendering handlers; the
  //     viewer renders failures through .catch chains, the same pattern zdtd
  //     uses.
  //   node/no-top-level-await: the viewer is a browser ES module, where
  //     top-level await is correct (unicorn/prefer-top-level-await is on).
  //   vitest/* and jsdoc/*: strict-tests rules do not apply to plain browser
  //     scripts and are not loaded.
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "env": { "browser": true, "es2024": true },
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "plugins": ["unicorn"],
  "jsPlugins": ["@rikalabs/oxlint-standards/plugin"],
  "rules": {
    // ---- dead / debug code ----
    "no-debugger": "error",
    "no-console": "error",
    "no-unused-vars": "error",
    "no-empty": "error",
    "no-empty-function": "error",
    "no-unreachable": "error",
    "no-useless-catch": "error",
    "no-self-compare": "error",
    "no-constant-condition": "error",
    "no-sequences": "error",
    "no-alert": "error",
    // ---- correctness of intent ----
    "eqeqeq": ["error", "always"],
    "no-cond-assign": "error",
    "no-fallthrough": "error",
    "no-implicit-coercion": ["error", { "allow": ["!!"] }],
    "radix": "error",
    "no-eval": "error",
    "no-new-func": "error",
    "no-new-wrappers": "error",
    "no-script-url": "error",
    "no-throw-literal": "error",
    "no-param-reassign": "error",
    "no-async-promise-executor": "error",
    "no-promise-executor-return": "error",
    "no-undef": "error",
    // ---- idiomatic modern JS ----
    "no-var": "error",
    "prefer-const": "error",
    "prefer-template": "error",
    "no-useless-concat": "error",
    "object-shorthand": "error",
    "prefer-destructuring": "error",
    "prefer-spread": "error",
    // ---- complexity / shape caps (strict-core thresholds) ----
    "max-lines-per-function": ["error", { "max": 60, "skipBlankLines": true, "skipComments": true }],
    "max-classes-per-file": ["error", 1],
    "max-lines": ["error", { "max": 1500, "skipBlankLines": true, "skipComments": true }],
    "max-nested-callbacks": ["error", 4],
    "no-nested-ternary": "error",
    "no-lonely-if": "error",
    "no-negated-condition": "error",
    "no-else-return": "error",
    "no-useless-return": "error",
    "default-case": "error",
    // ---- oxlint-standards strict-core native rules applicable to browser JS ----
    "no-warning-comments": "error",
    "no-shadow": ["error", { "hoist": "functions" }],
    "no-return-assign": "error",
    "no-loop-func": "error",
    "no-constructor-return": "error",
    "curly": ["error", "all"],
    "no-multi-assign": "error",
    "no-template-curly-in-string": "error",
    "no-labels": "error",
    "no-lone-blocks": "error",
    "prefer-object-has-own": "error",
    "no-implied-eval": "error",
    "prefer-promise-reject-errors": "error",
    "array-callback-return": "error",
    // ---- unicorn rules the viewer passes (2026-08-22) ----
    "unicorn/catch-error-name": "error",
    "unicorn/prefer-number-properties": "error",
    "unicorn/prefer-global-this": "error",
    "unicorn/prefer-query-selector": "error",
    "unicorn/prefer-dom-node-append": "error",
    "unicorn/prefer-dom-node-dataset": "error",
    "unicorn/prefer-add-event-listener": "error",
    "unicorn/prefer-at": "error",
    "unicorn/prefer-negative-index": "error",
    "unicorn/prefer-optional-catch-binding": "error",
    "unicorn/prefer-math-trunc": "error",
    "unicorn/prefer-code-point": "error",
    "unicorn/prefer-top-level-await": "error",
    "unicorn/prefer-includes": "error",
    "unicorn/explicit-length-check": "error",
    "unicorn/no-array-for-each": "error",
    "unicorn/no-array-callback-reference": "error",
    "unicorn/no-array-sort": "error",
    "unicorn/no-array-reverse": "error",
    "unicorn/no-nested-ternary": "error",
    "unicorn/numeric-separators-style": "error",
    "unicorn/number-literal-case": "error",
    // ---- oxlint-standards custom plugin (@rikalabs/*): anti-slop heuristics ----
    "@rikalabs/no-commented-out-code": "error",
    "@rikalabs/no-identical-branches": "error",
    "@rikalabs/no-tutorial-comments": "error",
    "@rikalabs/no-ai-debt-comments": "error",
    "@rikalabs/no-placeholder-implementation": "error",
    "@rikalabs/no-disable-without-rationale": "error",
    "@rikalabs/no-todo-without-issue": "error",
    "@rikalabs/no-low-signal-variable-names": "error",
    "@rikalabs/no-vague-verbs": "error",
    "@rikalabs/no-bare-wrapper-functions": "error",
    "@rikalabs/no-silent-catch-fallback": "error",
    "@rikalabs/no-trivial-property-helpers": "error",
    "@rikalabs/no-pass-through-intermediate-vars": "error",
    "@rikalabs/no-anemic-errors": "error",
    "@rikalabs/no-duplicate-context": "error",
    "@rikalabs/no-is-record-helpers": "error",
    "@rikalabs/no-single-use-trivial-helpers": "error",
    "@rikalabs/no-property-default-fallbacks": "error",
    "@rikalabs/no-double-type-assertion": "error",
    "@rikalabs/no-redundant-const-assertion": "error",
    "@rikalabs/no-hardcoded-secrets": "error",
    "@rikalabs/no-sql-string-concat": "error",
    // ---- off, with reason (see header) ----
    "no-underscore-dangle": "off",
    "no-bitwise": "off",
    "import/no-namespace": "off",
    "promise/avoid-new": "off",
    "promise/prefer-await-to-callbacks": "off",
    "node/no-top-level-await": "off",
    "@rikalabs/no-standalone-classes": "off",
    "@rikalabs/no-trivial-runtime-guard-helpers": "off"
  }
}
