<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Static analysis as a gate: EnableNETAnalyzers defaults off for net48,
         and warnings that stay warnings get ignored; both are raised to errors
         so a defect cannot merge unseen. Tree builds warning-free today;
         keep it that way. Next ratchet step is AnalysisMode=Recommended:
         blocked today by legacy-convention findings (CA1707 underscore names
         in 7DTD console commands, CA1051 public fields), not by noise alone. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <AssemblyName>RealEarth</AssemblyName>
    <RootNamespace>RealEarth</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Reproducible output: byte-identical DLL for identical inputs.
         Deterministic pins compilation output; PathMap maps the absolute
         project path to /_/ so checkouts from different directories (and the
         PDB path recorded in the debug directory) do not leak into the DLL;
         CI builds additionally normalize all source paths. -->
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildThisFileDirectory)=/_/</PathMap>
    <!-- Stamp provenance only when asked (-p:InformationalVersion=1.0.0+<sha>):
         left automatic, SDK 8 silently bakes the ambient git HEAD into the DLL
         version resource and a SourceLink JSON (remote URL + HEAD) into the PDB,
         and produces nothing outside a git checkout, so two checkouts of the
         same source yield different artifacts. Explicit -p:RepositoryUrl /
         -p:SourceRevisionId are still honored when provenance is wanted. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Steam/Proton Windows client (default; override with GameDir= or SEVENDTD_GAME_DIR) -->
    <GameDir Condition="'$(GameDir)' == ''">$(SEVENDTD_GAME_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">$(HOME)/.local/share/Steam/steamapps/common/7 Days To Die</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(GameDir)/7DaysToDie_Data/Managed/Assembly-CSharp.dll')">
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)/7DaysToDie_Data/Managed/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)/7DaysToDie_Data/Managed/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)/Mods/0_TFP_Harmony/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
