# Python
tools/.venv/
__pycache__/
tools/**/*.egg-info/
tools/.pytest_cache/
tools/dist/
tools/build/
*.pyc

# Data packs (large)
data/samples/**
!data/samples/.gitkeep

# Terrarium source-tile cache (pack rebuild inputs; back up with artifacts)
data/cache/**

# Timestamped artifact backups (make artifacts-backup; move off-host)
backups/**
# Pre-run snapshots a bake moves aside before overwriting its output
*.pre-bake-*/

# Viewer exports (regenerate with export-viewer)
viewer/data/**
!viewer/data/.gitkeep
!viewer/data/catalog.json

# Viewer build output (regenerate with make viewer-build) + lint toolchain link
viewer/js/**
viewer/node_modules

# webmod build output + exported pack data (regenerate with make webmod /
# make webmod-export). Lives inside the tracked webmod/ tree: a sibling
# "WebMod/" would collide with it on case-insensitive filesystems.
webmod/build/

# Baked single-world exports (large)
worlds/**
!worlds/.gitkeep

# C# / build
Source/**/bin/
Source/**/obj/
tools/engine_patcher/bin/
tools/engine_patcher/obj/
tools/network_protocol_inspector/bin/
tools/network_protocol_inspector/obj/
dist/
*.dll
*.pdb
*.user
.vs/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/

# uv cache
.uv-cache/


# scratch
.scratch/
# Dependency lockfiles are tracked (tools/uv.lock); only stray *.lock guard
# files from editors and half-finished tool runs are ignored.
*.lock
!tools/uv.lock
!bun.lock
.coverage
.coverage.*
