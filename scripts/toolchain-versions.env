# Single source of truth for the JavaScript toolchain versions used by the
# build/lint scripts (the repo tracks no package.json/node_modules on purpose;
# the cache is machine-local, so these pins plus the committed
# scripts/js-toolchain.lock are what the install is verified against):
#
#   scripts/build-viewer.sh  scripts/build-webmod.sh   esbuild
#   scripts/lint-viewer.sh   scripts/lint-webmod.sh    tsc / oxlint stack
#   scripts/lint-html.sh                               vnu
#
# Every consumer sources this file; the ${VAR:=default} form means an
# environment override still wins, so the existing per-script override
# invocations keep working:
#
#   TSC_VERSION=5.9.3 bash scripts/lint-viewer.sh
#
# Bump a pin here once and every script follows it, but the install then fails
# until scripts/js-toolchain.lock is re-locked (install-js-toolchain.sh runs
# `bun install --frozen-lockfile`, so a version without its locked hash stops
# the lint stage). Re-lock by running the failing install without
# --frozen-lockfile in the cache dir and copying the new bun.lock back here.
# .github/workflows/ci.yml hashes this file and the lock into the
# lint-toolchain cache key, so a bump also invalidates the cached node_modules.

# Bundler / minifier (viewer ES modules + webmod IIFE bundle)
: "${ESBUILD_VERSION:=0.28.2}"

# TypeScript type gate (tsc --noEmit over viewer/src and webmod/src)
: "${TSC_VERSION:=5.9.3}"

# oxlint core, type-aware backend, plugin API, and the @rikalabs rule set
: "${OXLINT_VERSION:=1.79.0}"
: "${OXLINT_TSGOLINT_VERSION:=7.0.2001}"
: "${OXLINT_PLUGINS_VERSION:=1.79.0}"
: "${OXLINT_STANDARDS_VERSION:=0.8.1}"
# Vendored dmmulroy/anti-slop plugin source (git commit, not an npm release).
# GitHub serves the archive tarball without an integrity manifest, so the
# expected sha256 is pinned next to the commit: a changed or truncated
# download fails the lint stage instead of silently feeding different plugin
# source into it.
: "${ANTI_SLOP_SHA:=6d538555cb151d4121ed51a27db81890eacf8ae9}"
: "${ANTI_SLOP_SHA256:=a720663fd2562e22e3da670769faa88dc34c9a761fdd9a7d285e20d92871848e}"

# three.js runtime version is pinned by viewer/index.html's importmap; these
# mirror it for the type gate (@types/three) and the import lint rule.
: "${THREE_TYPES_VERSION:=0.170.0}"
: "${THREE_VERSION:=0.170.0}"

# sha256 of the committed vendored three.js files (the only third-party code
# that ships in a release artifact). scripts/vendor-three.sh verifies them, so a
# tampered or hand-edited vendored blob fails the build instead of going out
# unreviewed; refresh them whenever a three.js version bump re-vendors.
: "${THREE_MODULE_SHA256:=ce1fa418de16a19495a9f72495580e3015d7745c296d3ce0485897f902ddedfb}"
: "${THREE_ORBIT_CONTROLS_SHA256:=80efaadea4f8a636a65fb0bd08bfef62f3d93a0bb94e2e7500f23176c5c07f4e}"

# W3C Nu Html Checker through the vnu-jar wrapper
: "${VNU_VERSION:=26.8.21}"
