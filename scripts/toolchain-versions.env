# Single source of truth for the JavaScript toolchain pins used by the
# build/lint scripts (the repo tracks no package.json/node_modules on purpose,
# so npm-style lockfiles cannot carry them):
#
#   scripts/build-viewer.sh  scripts/build-webmod.sh   esbuild
#   scripts/lint-viewer.sh   scripts/lint-webmod.sh    tsc / oxlint stack
#   scripts/lint-html.sh                               vnu
#
# Every consumer sources this file; the ${VAR:=default} form means an
# environment override still wins, so the existing per-script override
# invocations keep working:
#
#   TSC_VERSION=5.9.3 bash scripts/lint-viewer.sh
#
# Bump a pin here once and every script follows it. .github/workflows/ci.yml
# hashes this file into the lint-toolchain cache key, so a bump also
# invalidates the cached node_modules.

# Bundler / minifier (viewer ES modules + webmod IIFE bundle)
: "${ESBUILD_VERSION:=0.28.2}"

# TypeScript type gate (tsc --noEmit over viewer/src and webmod/src)
: "${TSC_VERSION:=5.9.3}"

# oxlint core, type-aware backend, plugin API, and the @rikalabs rule set
: "${OXLINT_VERSION:=1.79.0}"
: "${OXLINT_TSGOLINT_VERSION:=7.0.2001}"
: "${OXLINT_PLUGINS_VERSION:=1.79.0}"
: "${OXLINT_STANDARDS_VERSION:=0.8.1}"
# Vendored dmmulroy/anti-slop plugin source (git commit, not an npm release)
: "${ANTI_SLOP_SHA:=6d538555cb151d4121ed51a27db81890eacf8ae9}"

# three.js runtime version is pinned by viewer/index.html's importmap; these
# mirror it for the type gate (@types/three) and the import lint rule.
: "${THREE_TYPES_VERSION:=0.170.0}"
: "${THREE_VERSION:=0.170.0}"

# W3C Nu Html Checker through the vnu-jar wrapper
: "${VNU_VERSION:=26.8.21}"
